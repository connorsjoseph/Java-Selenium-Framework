<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SauceDemo Chrome-Only Suite" parallel="methods" thread-count="3"
       data-provider-thread-count="3" verbose="1">

    <listeners>
        <listener class-name="com.saucedemo.listeners.TestListener"/>
        <listener class-name="com.saucedemo.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.saucedemo.tests.LoginTest"/>
            <class name="com.saucedemo.tests.CheckoutTest"/>
        </classes>
    </test>

</suite>
